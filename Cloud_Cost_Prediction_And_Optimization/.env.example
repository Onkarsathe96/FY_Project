APP_NAME=Cloud_Cost_Prediction_And_Optimization
APP_ENV=development
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://cloud_cost_prediction_and_optimization:cloud_cost_prediction_and_optimization@localhost:5432/cloud_cost_prediction_and_optimization
POSTGRES_DB=cloud_cost_prediction_and_optimization
POSTGRES_USER=cloud_cost_prediction_and_optimization
POSTGRES_PASSWORD=cloud_cost_prediction_and_optimization
LOG_LEVEL=INFO

# Phase 3 real cloud ingestion settings.
# Leave these blank when using use_sample_data=true.
AWS_PROFILE=
AWS_REGION=us-east-1
# AWS identity must allow sts:GetCallerIdentity, ce:GetCostAndUsage,
# ec2:Describe*, cloudwatch:GetMetricStatistics, s3:ListAllMyBuckets,
# s3:ListBucket, s3:GetBucketLocation.
# The dashboard mutation actions additionally require ec2:StopInstances,
# ec2:TerminateInstances, ec2:DeleteVolume, and s3:DeleteBucket. These must be
# allowed on the target resources, not only in a read-only policy.
AZURE_SUBSCRIPTION_ID=
GCP_PROJECT_ID=
GCP_BILLING_EXPORT_TABLE=